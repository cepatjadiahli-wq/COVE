# ==============================================================================
# COVE V1 — STAGING ENVIRONMENT VARIABLES (.env.staging.example)
# Dedicated Staging Instance (Isolated from Development & Production)
# ==============================================================================

# Application URL (Staging Deployment Host)
NEXT_PUBLIC_APP_URL=https://cove-staging.vercel.app

# Supabase Staging Project Credentials
# (Obtain from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://cove-staging-db.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.staging-anon-key-placeholder

# Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.staging-service-role-key-placeholder

# Node Environment
NODE_ENV=production

# App Version & Region
NEXT_PUBLIC_APP_VERSION=v1.0.0-staging
NEXT_PUBLIC_DEFAULT_CURRENCY=IDR
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Jakarta

# Transactional Email Provider (Optional for Staging UAT)
# RESEND_API_KEY=re_staging_placeholder
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=staging_smtp_password
# SMTP_FROM=notifications@cove-staging.id

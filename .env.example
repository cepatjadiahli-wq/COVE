# ==============================================================================
# COVE V1 - Production & Cloud Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Connection (PostgreSQL + Auth + RLS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Mayar.id Payment Gateway (Indonesia)
# ------------------------------------------------------------------------------
# Mayar API Key from https://dashboard.mayar.id/settings/api-keys
MAYAR_API_KEY=your-mayar-api-key
# Secret token configured in Mayar Dashboard > Integration > Webhook
MAYAR_WEBHOOK_SECRET=your-mayar-webhook-secret
MAYAR_API_URL=https://api.mayar.id/hl/v1/payment/create

# ------------------------------------------------------------------------------
# 3. Application Settings & URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://app.cove.id
NEXT_PUBLIC_DEFAULT_CURRENCY=IDR
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Jakarta

# ------------------------------------------------------------------------------
# 4. Demo / Sandbox Mode
# ------------------------------------------------------------------------------
# Set to 'false' in production when connecting directly to Supabase cloud
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 5. Email Notification Provider (Optional)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-password
EMAIL_FROM=notifications@cove.id
